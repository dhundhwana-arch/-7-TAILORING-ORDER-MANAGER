# CUSTOM SHIRT STUDIO — Module 07: Tailoring Order Manager
# Copy to .env and adjust values for your environment. Never commit real secrets.

APP_NAME="Tailoring Order Manager"
APP_VERSION="0.1.0"
APP_ENV="development"
LOG_LEVEL="INFO"

# Database (PostgreSQL recommended in production; SQLite supported for local/dev)
# Example PostgreSQL: postgresql+psycopg://user:password@localhost:5432/tailoring_orders
DATABASE_URL="sqlite:///./tailoring_orders.db"

# Security & Authentication
# MUST be overridden with a strong 32+ character random secret in production
AUTH_SECRET_KEY="CHANGE_ME_BEFORE_PRODUCTION_USE_STRONG_RANDOM_SECRET"
TRACKING_TOKEN_SECRET="CHANGE_ME_BEFORE_PRODUCTION_USE_STRONG_TRACKING_SECRET"
# Allow structured X-Actor-* headers ONLY in local development/test; forced false in production
AUTH_DEV_HEADER_ENABLED="true"

# Rate Limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE="120"
TRACKING_RATE_LIMIT_PER_MINUTE="30"

# Cross-Module Integration Mode: "mock" (isolated dev/test) or "http" (live sibling services)
INTEGRATION_MODE="mock"
MODULE_02_FABRIC_BASE_URL="http://localhost:8002"
MODULE_03_DESIGN_BASE_URL="http://localhost:8003"
MODULE_04_PREVIEW_BASE_URL="http://localhost:8004"
MODULE_05_PRICING_BASE_URL="http://localhost:8005"
MODULE_06_MEASUREMENT_BASE_URL="http://localhost:8006"

# Notification Settings (never sends real external messages in development)
NOTIFICATION_PROVIDER="mock"
